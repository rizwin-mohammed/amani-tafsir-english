   "ar": "وَلَنَآ",
   "ml": "ഞങ്ങൾക്കായിരിക്കും, ഞങ്ങൾക്കുണ്ടായിരിക്കും",
   "en": "will be for us, will be with us"
  },
  {
   "verse": 139,
   "ar": "أَعۡمَٰلُنَا",
   "ml": "ഞങ്ങളുടെ കർമങ്ങൾ",
   "en": "our deeds"
  },
  {
   "verse": 139,
   "ar": "وَلَكُمۡ",
   "ml": "നിങ്ങൾക്കുണ്ടായിരിക്കും",
   "en": "will be with you"
  },
  {
   "verse": 139,
   "ar": "أَعۡمَٰلُكُمۡ",
   "ml": "നിങ്ങളുടെ കർമങ്ങൾ",
   "en": "your deeds"
  },
  {
   "verse": 139,
   "ar": "وَنَحۡنُ",
   "ml": "ഞങ്ങളാവട്ടെ",
   "en": "we, for our part,"
  },
  {
   "verse": 139,
   "ar": "لَهُۥ",
   "ml": "അവന്",
   "en": "to Him"
  },
  {
   "verse": 139,
   "ar": "مُخۡلِصُونَ",
   "ml": "നിഷ്കളങ്കരാകുന്നു",
   "en": "are sincere ones"
  },
  {
   "verse": 140,
   "ar": "أَمۡ تَقُولُونَ",
   "ml": "അതല്ല നിങ്ങൾ പറയുന്നുവോ",
   "en": "or else, do you say"
  },
  {
   "verse": 140,
   "ar": "إِنَّ إِبۡرَٰهِـۧمَ",
   "ml": "നിശ്ചയമായും ഇബ്റാഹീം",
   "en": "surely Ibrahim"
  },
  {
   "verse": 140,
   "ar": "وَإِسۡمَٰعِيلَ",
   "ml": "ഇസ്മാഈലും",
   "en": "and Isma'il"
  },
  {
   "verse": 140,
   "ar": "وَإِسۡحَٰقَ",
   "ml": "ഇസ്ഹാക്വും",
   "en": "and Ishaq"
  },
  {
   "verse": 140,
   "ar": "وَيَعۡقُوبَ",
   "ml": "യഅ്ക്വൂബും",
   "en": "and Ya'qub"
  },
  {
   "verse": 140,
   "ar": "وَٱلۡأَسۡبَاطَ",
   "ml": "(യഅ്ക്വൂബ്)സന്തതികളും",
   "en": "and the (Ya'qub) progeny"
