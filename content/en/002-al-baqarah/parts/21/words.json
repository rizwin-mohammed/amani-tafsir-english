  {
   "verse": 140,
   "ar": "أَمِ ٱللَّهُ",
   "ml": "അതോ അല്ലാഹുവോ",
   "en": "or Allah?"
  },
  {
   "verse": 140,
   "ar": "وَمَنۡ",
   "ml": "ആരാണ്",
   "en": "who is"
  },
  {
   "verse": 140,
   "ar": "أَظۡلَمُ",
   "ml": "അധികം അക്രമി",
   "en": "more of a wrongdoer"
  },
  {
   "verse": 140,
   "ar": "مِمَّن كَتَمَ",
   "ml": "മറച്ചുവെച്ചവനെക്കാൾ",
   "en": "than one who concealed"
  },
  {
   "verse": 140,
   "ar": "شَهَٰدَةً",
   "ml": "ഒരു സാക്ഷ്യം, വല്ല സാക്ഷ്യത്തെയും",
