  {
   "verse": 140,
   "ar": "مِنَ ٱللَّهِ",
   "ml": "അല്ലാഹുവിൽ നിന്ന്",
   "en": "from Allah"
  },
  {
   "verse": 140,
   "ar": "وَمَا ٱللَّهُ",
   "ml": "അല്ലാഹു അല്ലതാനും",
   "en": "Allah is not, moreover"
  },
  {
   "verse": 140,
   "ar": "بِغَٰفِلٍ",
   "ml": "അശ്രദ്ധനേ",
   "en": "unmindful in any way"
  },
  {
   "verse": 140,
   "ar": "عَمَّا تَعۡمَلُونَ",
   "ml": "നിങ്ങൾ പ്രവർത്തിക്കുന്നതിനെപ്പറ്റി",
   "en": "of what you do"
  }
 ]
