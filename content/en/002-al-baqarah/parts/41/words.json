  },
  {
   "verse": 249,
   "ar": "ٱلَّذِينَ يَظُنُّونَ",
   "ml": "വിചാരിക്കുന്നവർ",
   "en": "those who think"
  },
  {
   "verse": 249,
   "ar": "أَنَّهُم",
