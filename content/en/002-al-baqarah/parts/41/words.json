  },
  {
   "verse": 249,
   "ar": "فَشَرِبُواْ",
   "ml": "എന്നിട്ട് അവർ കുടിച്ചു",
   "en": "then they drank"
  },
  {
   "verse": 249,
   "ar": "مِنۡهُ",
   "ml": "അതിൽ നിന്ന്",
   "en": "from it"
  },
  {
   "verse": 249,
   "ar": "إِلَّا قَلِيلٗا",
   "ml": "അൽപം (ആളുകൾ) ഒഴികെ",
   "en": "except a few (folk)"
  },
  {
   "verse": 249,
