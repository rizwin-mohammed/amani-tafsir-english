   "verse": 249,
   "ar": "مِّن فِئَةٖ",
   "ml": "സംഘത്തിൽനിന്ന്",
   "en": "from band"
  },
  {
   "verse": 249,
   "ar": "قَلِيلَةٍ",
   "ml": "കുറഞ്ഞ, അൽപമായ",
   "en": "small, that is few"
  },
  {
   "verse": 249,
   "ar": "غَلَبَتۡ",
   "ml": "ജയിച്ചിരിക്കുന്നു",
   "en": "has overcome"
  },
  {
   "verse": 249,
   "ar": "فِئَةٗ كَثِيرَةَۢ",
   "ml": "അധികരിച്ച (വളരെയുള്ള) സംഘത്തെ",
   "en": "a band that is abounding (that is very many)"
  },
  {
   "verse": 249,
   "ar": "بِإِذۡنِ ٱللَّهِ",
   "ml": "അല്ലാഹുവിന്റെ അനുമതി കൊണ്ട് (ഉത്തരവ്- സമ്മതപ്രകാരം)",
   "en": "by the permission of Allah (order – according to consent)"
  },
  {
   "verse": 249,
   "ar": "وَٱللَّهُ",
   "ml": "അല്ലാഹുവാകട്ടെ",
   "en": "Allah, for His part"
  },
  {
   "verse": 249,
   "ar": "مَعَ ٱلصَّـٰبِرِينَ",
   "ml": "ക്ഷമിക്കുന്നവരോട് കൂടെയായിരിക്കും",
   "en": "will be together with those who are patient"
  }
 ]
