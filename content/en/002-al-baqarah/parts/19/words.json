   "en": "the occasion of putting to trial"
  },
  {
   "verse": 124,
   "ar": "إِبۡرَٰهِـۧمَ",
   "ml": "ഇബ്റാഹീമിനെ",
   "en": "Ibrahim"
  },
  {
   "verse": 124,
   "ar": "رَبُّهُۥ",
   "ml": "അദ്ദേഹത്തിന്റെ റബ്ബ്",
   "en": "his Rabb"
  },
  {
   "verse": 124,
   "ar": "بِكَلِمَٰتٖ",
   "ml": "ചില വാക്കുകൾ മൂലം",
   "en": "by means of some words"
  },
  {
   "verse": 124,
   "ar": "فَأَتَمَّهُنَّ",
   "ml": "എന്നിട്ട് അവയെ അദ്ദേഹം പൂർത്തിയാക്കി",
   "en": "then he completed them"
  },
  {
   "verse": 124,
   "ar": "قَالَ",
   "ml": "അവൻ പറഞ്ഞു",
   "en": "He said"
  },
  {
   "verse": 124,
   "ar": "إِنِّي جَاعِلُكَ",
   "ml": "നിശ്ചയമായും ഞാൻ നിന്നെ ആക്കുന്നവനാണ്",
   "en": "surely I am the one who makes you"
  },
  {
   "verse": 124,
   "ar": "لِلنَّاسِ",
   "ml": "മനുഷ്യർക്ക്",
   "en": "for mankind"
  },
  {
   "verse": 124,
   "ar": "إِمَامٗا",
   "ml": "നേതാവ് , മുമ്പൻ",
   "en": "leader , foremost one"
  },
  {
   "verse": 124,
   "ar": "قَالَ",
   "ml": "അദ്ദേഹം പറഞ്ഞു",
   "en": "he said"
  },
  {
   "verse": 124,
   "ar": "وَمِن ذُرِّيَّتِي",
   "ml": "എന്റെ സന്തതികളിൽ (സന്താനപരമ്പരയിൽ) നിന്നും",
   "en": "from my progeny (line of descendants)"
  },
  {
   "verse": 124,
   "ar": "قَالَ",
   "ml": "അവൻ പറഞ്ഞു",
   "en": "He said"
  },
  {
   "verse": 124,
   "ar": "لَا يَنَالُ",
   "ml": "ബാധിക്കുക (എത്തുക, കിട്ടുക)യില്ല",
   "en": "will not befall (reach, be obtained)"
  },
  {
   "verse": 124,
   "ar": "عَهۡدِي",
   "ml": "എന്റെ കരാർ, വാഗ്ദത്തം",
   "en": "My pact, promise"
  },
  {
   "verse": 124,
   "ar": "ٱلظَّـٰلِمِينَ",
   "ml": "അക്രമികളെ",
   "en": "the wrongdoers"
  },
  {
   "verse": 125,
   "ar": "وَإِذۡ جَعَلۡنَا",
   "ml": "നാം ആക്കിയ സന്ദർഭം",
   "en": "the occasion when We made"
  },
  {
   "verse": 125,
   "ar": "ٱلۡبَيۡتَ",
   "ml": "ആ വീട് (കഅ്ബഃ)",
   "en": "that house (Ka'bah)"
  },
  {
   "verse": 125,
   "ar": "مَثَابَةٗ",
   "ml": "ഒരു സങ്കേതം",
   "en": "a resort"
  },
  {
   "verse": 125,
   "ar": "لِّلنَّاسِ",
   "ml": "മനുഷ്യർക്ക്",
   "en": "for mankind"
  },
  {
   "verse": 125,
   "ar": "وَأَمۡنٗا",
   "ml": "അഭയവും",
   "en": "shelter too"
  },
  {
   "verse": 125,
   "ar": "وَٱتَّخِذُواْ",
   "ml": "നിങ്ങൾ ഉണ്ടാക്കുകയും ചെയ്യുവിൻ",
   "en": "and you make"
  },
  {
   "verse": 125,
   "ar": "مِن مَّقَامِ إِبۡرَٰهِـۧمَ",
   "ml": "ഇബ്റാഹീം നിന്ന സ്ഥാനത്ത് നിന്ന്",
   "en": "from the place where Ibrahim stood"
  },
  {
   "verse": 125,
   "ar": "مُصَلّٗى",
   "ml": "ഒരു നമസ്കാര സ്ഥാനം",
   "en": "a place of prayer"
  },
  {
   "verse": 125,
   "ar": "وَعَهِدۡنَآ",
   "ml": "നാം കൽപന കൊടുക്കുകയും ചെയ്തു",
   "en": "and We gave command"
  },
  {
   "verse": 125,
   "ar": "إِلَىٰٓ إِبۡرَٰهِـۧمَ",
   "ml": "ഇബ്റാഹീമിന്",
   "en": "to Ibrahim"
  },
  {
   "verse": 125,
   "ar": "وَإِسۡمَٰعِيلَ",
   "ml": "ഇസ്മാഈലിനും",
   "en": "to Isma'il too"
  },
  {
   "verse": 125,
   "ar": "أَن طَهِّرَا",
   "ml": "നിങ്ങൾ രണ്ടാളും ശുദ്ധമാക്കണമെന്ന്",
   "en": "that you two should purify"
  },
  {
   "verse": 125,
   "ar": "بَيۡتِيَ",
   "ml": "എന്റെ വീട്",
   "en": "My house"
  },
  {
   "verse": 125,
   "ar": "لِلطَّآئِفِينَ",
   "ml": "ത്വവാഫ് (പ്രദക്ഷിണം)ചെയ്യുന്നവർക്ക്",
   "en": "for those who do tawaf (circumambulation)"
  },
  {
   "verse": 125,
   "ar": "وَٱلۡعَٰكِفِينَ",
   "ml": "ഭജനമിരിക്കുന്നവർക്ക്",
   "en": "for those who sit in devotion"
  },
  {
   "verse": 125,
   "ar": "وَٱلرُّكَّعِ",
   "ml": "കുമ്പിടുന്ന (കുമ്പിട്ടു നമസ്കരിക്കുന്ന)വർക്കും",
   "en": "for those who bow (bow and perform the prayer) too"
  },
  {
   "verse": 125,
   "ar": "ٱلسُّجُودِ",
   "ml": "സുജൂദ് (സാഷ്ടാംഗ നമസ്കാരം)ചെയ്യുന്നവരായ",
   "en": "who are doing sujud (prostrate prayer)"
  }
 ]
