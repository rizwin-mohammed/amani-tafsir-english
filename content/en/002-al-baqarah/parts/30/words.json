  },
  {
   "verse": 187,
   "ar": "كَذَٰلِكَ",
   "ml": "അപ്രകാരം",
   "en": "thus"
  },
  {
   "verse": 187,
   "ar": "يُبَيِّنُ ٱللَّهُ",
