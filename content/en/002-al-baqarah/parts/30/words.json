{
 "words": [
  {
   "verse": 186,
   "ar": "وَإِذَا سَأَلَكَ",
   "ml": "നിന്നോടുചോദിച്ചാൽ",
   "en": "if … ask you"
  },
  {
   "verse": 186,
   "ar": "عِبَادِي",
   "ml": "എന്റെ അടിയാൻമാർ",
   "en": "My servants"
  },
  {
   "verse": 186,
   "ar": "عَنِّي",
   "ml": "എന്നെപ്പറ്റി",
   "en": "about Me"
  },
  {
   "verse": 186,
   "ar": "فَإِنِّي",
   "ml": "എന്നാൽ നിശ്ചയമായും ഞാൻ",
   "en": "then surely I"
  },
  {
   "verse": 186,
   "ar": "قَرِيبٌ",
   "ml": "സമീപസ്ഥനാണ്,",
   "en": "am near,"
  },
  {
   "verse": 186,
   "ar": "أُجِيبُ",
   "ml": "ഞാൻ ഉത്തരം നൽകും",
   "en": "I will give answer"
  },
  {
   "verse": 186,
   "ar": "دَعۡوَةَ",
   "ml": "വിളിക്ക്, പ്രാർത്ഥനക്ക്",
   "en": "to the call, to the supplication"
  },
  {
   "verse": 186,
   "ar": "ٱلدَّاعِ",
   "ml": "വിളിക്കുന്ന (പ്രാർത്ഥിക്കുന്ന)വന്റെ",
   "en": "of the one who calls (prays)"
  },
  {
   "verse": 186,
   "ar": "إِذَا دَعَانِ",
   "ml": "അവൻ എന്നെ വിളിച്ചാൽ, എന്നോട് പ്രാർത്ഥിച്ചാൽ",
   "en": "if he calls Me, if he prays to Me"
  },
  {
   "verse": 186,
   "ar": "فَلۡيَسۡتَجِيبُواْ",
   "ml": "എന്നാൽ അവർ ഉത്തരം ചെയ്യട്ടെ, അതിനാൽ അവർ ഉത്തരം തേടിക്കൊള്ളട്ടെ",
   "en": "then let them answer, therefore let them seek an answer"
  },
  {
   "verse": 186,
   "ar": "لِي",
   "ml": "എനിക്ക്, എന്നോട്",
   "en": "to Me, of Me"
  },
  {
   "verse": 186,
   "ar": "وَلۡيُؤۡمِنُواْ",
   "ml": "അവർ വിശ്വസിക്കുകയും ചെയ്യട്ടെ",
   "en": "and let them believe"
  },
  {
   "verse": 186,
   "ar": "بِي",
   "ml": "എന്നിൽ, എന്നെക്കൊണ്ട്",
   "en": "in Me, by Me"
  },
  {
   "verse": 186,
   "ar": "لَعَلَّهُمۡ",
   "ml": "അവരായേക്കാം, ആകുവാൻവേണ്ടി",
   "en": "they may be, so that they may be"
  },
  {
   "verse": 186,
   "ar": "يَرۡشُدُونَ",
   "ml": "അവർ നേർവഴിക്കാകും",
   "en": "they will be on the right path"
  },
  {
   "verse": 187,
   "ar": "أُحِلَّ",
   "ml": "ഹലാലാക്ക (അനുവദിക്ക)പ്പെട്ടിരിക്കുന്നു",
   "en": "has been made halal (permitted)"
  },
  {
   "verse": 187,
   "ar": "لَكُمۡ",
   "ml": "നിങ്ങൾക്ക്",
   "en": "to you"
  },
  {
   "verse": 187,
   "ar": "لَيۡلَةَ",
   "ml": "രാത്രിയിൽ",
