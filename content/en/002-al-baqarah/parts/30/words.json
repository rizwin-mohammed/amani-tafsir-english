  {
   "verse": 187,
   "ar": "ثُمَّ أَتِمُّواْ",
   "ml": "പിന്നെ നിങ്ങൾ പൂർത്തിയാക്കുവിൻ",
   "en": "then complete"
  },
  {
   "verse": 187,
   "ar": "ٱلصِّيَامَ",
   "ml": "നോമ്പ്",
   "en": "the fast"
  },
  {
   "verse": 187,
   "ar": "إِلَى ٱلَّيۡلِ",
