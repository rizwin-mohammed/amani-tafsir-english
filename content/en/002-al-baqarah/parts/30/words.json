  {
   "verse": 187,
   "ar": "إِلَىٰ نِسَآئِكُمۡ",
   "ml": "നിങ്ങളുടെ സ്ത്രീകളുമായി",
   "en": "with your women"
  },
  {
   "verse": 187,
   "ar": "هُنَّ",
   "ml": "അവർ",
   "en": "they"
  },
  {
   "verse": 187,
   "ar": "لِبَاسٞ لَّكُمۡ",
   "ml": "നിങ്ങൾക്ക് ഒരു വസ്ത്രമാണ്",
   "en": "are a garment for you"
  },
  {
   "verse": 187,
   "ar": "وَأَنتُمۡ",
   "ml": "നിങ്ങളും",
   "en": "and you"
  },
  {
   "verse": 187,
   "ar": "لِبَاسٞ لَّهُنَّ",
   "ml": "അവർക്ക് ഒരു വസ്ത്രമാണ്",
   "en": "are a garment for them"
  },
  {
   "verse": 187,
   "ar": "عَلِمَ ٱللَّهُ",
   "ml": "അല്ലാഹു അറിഞ്ഞിരിക്കുന്നു",
   "en": "Allah has come to know"
  },
  {
   "verse": 187,
   "ar": "أَنَّكُمۡ كُنتُمۡ",
   "ml": "നിങ്ങളായിരുന്നുവെന്ന്",
   "en": "that you were"
