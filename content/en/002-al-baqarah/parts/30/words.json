  },
  {
   "verse": 187,
   "ar": "ءَايَٰتِهِۦ",
   "ml": "അവന്റെ ആയത്ത് (ലക്ഷ്യം- വചനം)കൾ",
   "en": "His ayah (evidence – verse)s"
  },
  {
   "verse": 187,
   "ar": "لِلنَّاسِ",
   "ml": "മനുഷ്യർക്ക്",
   "en": "to mankind"
  },
  {
   "verse": 187,
   "ar": "لَعَلَّهُمۡ",
   "ml": "അവരായേക്കാം, ആകുവാൻ വേണ്ടി",
   "en": "they may be, so that they may be"
  },
  {
   "verse": 187,
   "ar": "يَتَّقُونَ",
   "ml": "അവർ സൂക്ഷ്മത പാലിക്കും.",
