{
 "words": [
  {
   "verse": 255,
   "ar": "ٱللَّهُ",
   "ml": "അല്ലാഹു",
   "en": "Allah"
  },
  {
   "verse": 255,
   "ar": "لَآ إِلَٰهَ",
   "ml": "ഒരു ഇലാഹുമല്ല, ആരാധ്യനേയില്ല, ദൈവവുമില്ല",
   "en": "not any Ilah, there is no object of worship at all, nor any god"
  },
  {
   "verse": 255,
   "ar": "إِلَّا هُوَ",
   "ml": "അവനല്ലാതെ",
   "en": "except Him"
  },
  {
   "verse": 255,
   "ar": "ٱلۡحَيُّ",
   "ml": "ജീവത്തായുള്ളവനാണ്",
   "en": "is the One who is living"
  },
  {
   "verse": 255,
   "ar": "ٱلۡقَيُّومُ",
   "ml": "സർവ്വ നിയന്താവാണ്, സ്വയം നിലകൊള്ളുന്നവൻ",
   "en": "is the Controller of all, One who subsists by Himself"
  },
  {
   "verse": 255,
   "ar": "لَا تَأۡخُذُهُۥ",
   "ml": "അവനെ പിടിപെടുകയില്ല",
   "en": "will not take hold of Him"
  },
  {
