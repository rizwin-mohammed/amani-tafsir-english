{
 "words": [
  {
   "verse": 180,
   "ar": "كُتِبَ",
   "ml": "നിയമിക്ക (രേഖപ്പെടുത്ത)പ്പെട്ടിരിക്കുന്നു",
   "en": "has been prescribed (recorded)"
  },
  {
   "verse": 180,
   "ar": "عَلَيۡكُمۡ",
   "ml": "നിങ്ങളുടെ മേൽ",
   "en": "upon you"
  },
  {
   "verse": 180,
   "ar": "إِذَا حَضَرَ",
   "ml": "ആസന്നമായാൽ",
   "en": "if … draws near"
  },
  {
   "verse": 180,
   "ar": "أَحَدَكُمُ",
   "ml": "നിങ്ങളിൽ ഒരുവന്",
   "en": "to one of you"
  },
  {
   "verse": 180,
   "ar": "ٱلۡمَوۡتُ",
   "ml": "മരണം",
   "en": "death"
  },
  {
   "verse": 180,
   "ar": "إِن تَرَكَ",
   "ml": "അവൻ വിട്ടു (ബാക്കിയാക്കി) പോകുന്നപക്ഷം",
   "en": "in case he leaves (leaving remaining) behind"
  },
  {
   "verse": 180,
   "ar": "خَيۡرًا",
   "ml": "വല്ല ഗുണവും, നല്ലതിനെ",
   "en": "any good, that which is good"
  },
  {
   "verse": 180,
   "ar": "ٱلۡوَصِيَّةُ",
   "ml": "വസ്വിയ്യത്ത് (ഒസ്യത്ത്) ചെയ്യൽ, മരണപത്രം",
   "en": "making wasiyyah (osyath), a will"
  },
  {
   "verse": 180,
   "ar": "لِلۡوَٰلِدَيۡنِ",
   "ml": "മാതാപിതാക്കൾക്ക്",
   "en": "to parents"
  },
  {
   "verse": 180,
   "ar": "وَٱلۡأَقۡرَبِينَ",
   "ml": "അടുത്ത ബന്ധുക്കൾക്കും",
   "en": "and to close relatives"
  },
  {
   "verse": 180,
   "ar": "بِٱلۡمَعۡرُوفِ",
   "ml": "ആചാരമനുസരിച്ച്, മര്യാദപ്രകാരം",
   "en": "in accordance with custom, according to propriety"
  },
  {
   "verse": 180,
   "ar": "حَقًّا",
   "ml": "കടമ, മുറ",
   "en": "a duty, a due"
  },
  {
   "verse": 180,
   "ar": "عَلَى ٱلۡمُتَّقِينَ",
   "ml": "സൂക്ഷ്മത പാലിക്കുന്നവരുടെ (ഭയഭക്തമാരുടെ) മേൽ",
   "en": "upon those who observe caution (the God-fearing)"
  },
  {
   "verse": 181,
   "ar": "فَمَنۢ",
   "ml": "എന്നിട്ട് (എന്നാൽ) ആരെങ്കിലും",
   "en": "then (but) anyone"
  },
  {
   "verse": 181,
   "ar": "بَدَّلَهُۥ",
   "ml": "അതിനെ മാറ്റി മറിച്ചു, ഭേദഗതി വരുത്തി",
   "en": "altered it, made an amendment"
  },
  {
   "verse": 181,
   "ar": "بَعۡدَ",
   "ml": "ശേഷം, പിറകെ",
   "en": "after, following"
  },
  {
   "verse": 181,
   "ar": "مَا سَمِعَهُۥ",
   "ml": "അതവൻ കേട്ടതിന്റെ",
   "en": "of his having heard it"
  },
  {
   "verse": 181,
   "ar": "فَإِنَّمَآ إِثۡمُهُۥ",
   "ml": "എന്നാലതിന്റെ കുറ്റം (തന്നെ- മാത്രം)",
   "en": "then the offence of it (indeed – only)"
  },
  {
   "verse": 181,
   "ar": "عَلَى ٱلَّذِينَ",
   "ml": "യാതൊരുവരുടെ മേൽ",
   "en": "upon those who"
  },
  {
   "verse": 181,
   "ar": "يُبَدِّلُونَهُۥٓ",
   "ml": "അവർ അതിനെ മാറ്റി മറിക്കും",
   "en": "they will alter it"
  },
  {
   "verse": 181,
   "ar": "إِنَّ ٱللَّهَ",
   "ml": "നിശ്ചയമായും അല്ലാഹു",
   "en": "surely Allah"
  },
  {
   "verse": 181,
   "ar": "سَمِيعٌ",
   "ml": "കേൾക്കുന്നവനാണ്",
   "en": "is one who hears"
  },
  {
   "verse": 181,
   "ar": "عَلِيمٞ",
   "ml": "അറിയുന്നവനാണ്",
   "en": "is one who knows"
  },
  {
   "verse": 182,
   "ar": "فَمَنۡ خَافَ",
   "ml": "എന്നാൽ ആരെങ്കിലും ഭയപ്പെട്ടാൽ",
   "en": "but if anyone fears"
  },
  {
   "verse": 182,
   "ar": "مِن مُّوصٖ",
   "ml": "വല്ല വസ്വിയ്യത്തുകാരനിൽ (വസ്വിയ്യത്തുചെയ്യുന്ന ഒരാളിൽ) നിന്ന്",
   "en": "from any maker of wasiyyah (from a person who makes wasiyyah)"
  },
  {
   "verse": 182,
   "ar": "جَنَفًا",
   "ml": "വല്ല ചായ്‌വും, മറിവും,",
   "en": "any leaning, and swerving,"
  },
  {
   "verse": 182,
   "ar": "أَوۡ إِثۡمٗا",
   "ml": "അല്ലെങ്കിൽ തെറ്റ്, പാപം",
   "en": "or a wrong, a sin"
  },
  {
   "verse": 182,
   "ar": "فَأَصۡلَحَ",
   "ml": "എന്നിട്ട് അവൻ നന്നാക്കി",
   "en": "then he set right"
  },
  {
   "verse": 182,
   "ar": "بَيۡنَهُمۡ",
   "ml": "അവർക്കിടയിൽ",
   "en": "between them"
  },
  {
   "verse": 182,
   "ar": "فَلَآ إِثۡمَ",
   "ml": "എന്നാൽ കുറ്റമില്ല",
   "en": "then there is no offence"
  },
  {
   "verse": 182,
   "ar": "عَلَيۡهِ",
   "ml": "അവന്റെ മേൽ,",
   "en": "on him,"
  },
  {
   "verse": 182,
   "ar": "إِنَّ ٱللَّهَ",
   "ml": "നിശ്ചയമായും അല്ലാഹു",
   "en": "surely Allah"
  },
  {
   "verse": 182,
   "ar": "غَفُورٞ",
   "ml": "വളരെ പൊറുക്കുന്നവനാണ്",
   "en": "is one who forgives much"
  },
  {
   "verse": 182,
   "ar": "رَّحِيمٞ",
   "ml": "കരുണാനിധിയാണ്.",
   "en": "is the Ever-Merciful."
  }
 ]
}
