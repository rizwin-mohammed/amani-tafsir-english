   "ml": "അവരുടെ മക്കളും (സന്താനങ്ങളും) ഇല്ല",
   "en": "nor their children (offspring)"
  },
  {
   "verse": 116,
   "ar": "مِّنَ ٱللَّهِ",
   "ml": "അല്ലാഹുവിൽ നിന്ന്",
   "en": "from Allah"
  },
  {
   "verse": 116,
   "ar": "شَيۡـٔٗا",
   "ml": "യാതൊന്നും ഒട്ടും",
   "en": "anything, at all"
  },
  {
   "verse": 116,
   "ar": "وَأُوْلَـٰٓئِكَ",
   "ml": "അക്കൂട്ടർ",
   "en": "those people"
  },
  {
   "verse": 116,
   "ar": "أَصۡحَٰبُ ٱلنَّارِ",
   "ml": "നരകത്തിന്റെ ആൾക്കാരുമാകുന്നു",
   "en": "are the people of Hell, too"
  },
  {
   "verse": 116,
   "ar": "هُمۡ فِيهَا",
   "ml": "അവർ അതിൽ",
   "en": "they, in it"
  },
  {
   "verse": 116,
   "ar": "خَٰلِدُونَ",
   "ml": "സ്ഥിരവാസികൾ ആകുന്നു",
   "en": "are permanent residents"
  },
  {
   "verse": 117,
   "ar": "مَثَلُ مَا",
   "ml": "യാതൊന്നിന്റെ ഉപമ, ഉദാഹരണം",
   "en": "the parable, the example, of what"
  },
  {
   "verse": 117,
   "ar": "يُنفِقُونَ",
   "ml": "അവർ ചിലവഴിക്കുന്ന",
   "en": "they spend"
  },
  {
   "verse": 117,
   "ar": "فِي هَٰذِهِ ٱلۡحَيَوٰةِ",
   "ml": "ഈ ജീവിതത്തിൽ",
   "en": "in this life"
  },
  {
   "verse": 117,
   "ar": "ٱلدُّنۡيَا",
   "ml": "ഐഹികമായ",
   "en": "worldly"
  },
  {
   "verse": 117,
   "ar": "كَمَثَلِ",
   "ml": "ഉപമപോലെയാണ്",
   "en": "is like the parable"
  },
  {
   "verse": 117,
   "ar": "رِيحٖ",
   "ml": "ഒരു കാറ്റിന്റെ",
   "en": "of a wind"
  },
  {
   "verse": 117,
   "ar": "فِيهَا",
   "ml": "അതിലുണ്ട്",
   "en": "in it there is"
  },
  {
   "verse": 117,
   "ar": "صِرٌّ",
   "ml": "അതിശൈത്യം",
   "en": "intense cold"
  },
  {
   "verse": 117,
   "ar": "أَصَابَتۡ",
   "ml": "അത് ബാധിച്ചു",
   "en": "it struck"
  },
  {
   "verse": 117,
   "ar": "حَرۡثَ قَوۡمٖ",
   "ml": "ഒരു ജനതയുടെ വിളയ്ക്ക്, വിളയിടത്തിന്",
   "en": "to the crop of a people, to the crop-land"
  },
  {
   "verse": 117,
   "ar": "ظَلَمُوٓاْ",
   "ml": "അവർ അക്രമം (അനീതി) ചെയ്തിരിക്കുന്നു",
   "en": "they have done wrongdoing (injustice)"
  },
  {
   "verse": 117,
   "ar": "أَنفُسَهُمۡ",
   "ml": "തങ്ങളുടെ സ്വന്തങ്ങളോട്",
   "en": "towards their own selves"
  },
  {
   "verse": 117,
   "ar": "فَأَهۡلَكَتۡهُ",
   "ml": "എന്നിട്ടത് അതിനെ നശിപ്പിച്ചു",
   "en": "then it destroyed it"
  },
  {
   "verse": 117,
   "ar": "وَمَا ظَلَمَهُمُ",
   "ml": "അവരെ അക്രമിച്ചിട്ടുമില്ല",
   "en": "and has not wronged them"
  },
  {
   "verse": 117,
   "ar": "ٱللَّهُ",
   "ml": "അല്ലാഹു",
   "en": "Allah"
  },
  {
   "verse": 117,
   "ar": "وَلَٰكِنۡ",
   "ml": "എങ്കിലും, പക്ഷേ",
   "en": "but, however"
  },
  {
   "verse": 117,
   "ar": "أَنفُسَهُمۡ",
   "ml": "അവരുടെ സ്വന്തങ്ങളെ, തങ്ങളെത്തന്നെ",
   "en": "their own selves, themselves indeed"
  },
  {
   "verse": 117,
   "ar": "يَظۡلِمُونَ",
   "ml": "അവർ അക്രമിക്കുന്നു.",
   "en": "they wrong."
  }
 ]
}