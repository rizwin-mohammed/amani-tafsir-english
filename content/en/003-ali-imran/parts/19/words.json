   "verse": 180,
   "ar": "ٱلسَّمَٰوَٰتِ",
   "ml": "ആകാശങ്ങളുടെ",
   "en": "of the heavens"
  },
  {
   "verse": 180,
   "ar": "وَٱلۡأَرۡضِ",
   "ml": "ഭൂമിയുടെയും",
